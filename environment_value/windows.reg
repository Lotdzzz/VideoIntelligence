Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Environment]
; nacos配置
"NACOS_SERVER_HOST_PORT"=""
"NACOS_GROUP"="DOTM_GROUP"
"VI_GROUP"="VI_GROUP"

; 消息队列配置
"RABBITMQ_SERVER_HOST"=""
"RABBITMQ_SERVER_PORT"=""
"RABBITMQ_SERVER_USERNAME"=""
"RABBITMQ_SERVER_PASSWORD"=""

; 数据库配置
"DATASOURCE_HOST_PORT"=""
"DATASOURCE_DATABASES"=""
"DATASOURCE_USERNAME"=""
"DATASOURCE_PASSWORD"=""

; redis配置
"REDIS_HOST"=""
"REDIS_PORT"=""
"REDIS_PASSWORD"=""

; 网关配置
"GATEWAY_PROFILES"="gateway,common,auth"
; 认证中心配置
"AUTH_PROFILES"="auth,dev,common,ai"
; 认证监控配置
"AUTH_MONITOR_PROFILE"="common,dev"
; 系统监控配置
"SYSTEM_MONITOR_PROFILE"="common,dev"
; 文件上传模块配置
"FILE_PROFILE"="dev,file"

; VI文件模块
"SERVICE_FILE_PROFILE"="dev,file,common"

; 微服务端口配置
"GATEWAY_PORT"="8080" ; 网关
"AUTH_PORT"="1000" ;认证中心
"AUTH_MONITOR_PORT"="9999" ;认证中心监控
"SYSTEM_MONITOR_PORT"="9998" ;系统监控
"FILE_PORT"="9997" ;文件
; 业务服务端口配置
"SERVICE_FILE"="1001" ;VI文件服务

; jwt密钥配置
"SECRET_KEY"=""

; github认证密钥配置
"CLIENT_ID"=""
"CLIENT_SECRET"=""

; AI的密钥配置
"API_KEY"=""

; 阿里云OSS密钥配置
"OSS_ACCESS_KEY_ID"=""
"OSS_ACCESS_KEY_SECRET"=""

; MinIO密钥配置
"MINIO_ACCESS_KEY"=""
"MINIO_SECRET_KEY"=""