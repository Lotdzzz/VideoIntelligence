<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dotm.mapper.SysUserRoleMapper">

    <resultMap id="BaseResultMap" type="com.dotm.entity.model.SysUserRole">
            <result property="userId" column="user_id" />
            <result property="roleId" column="role_id" />
    </resultMap>

    <sql id="Base_Column_List">
        user_id,role_id
    </sql>

    <insert id="bindRolesByUserId">
        insert into sys_user_role(user_id, role_id) values
        <foreach collection="roleIds" item="roleId" index="index" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>
</mapper>

